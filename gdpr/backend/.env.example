# ========================================
# A2A GUARD BACKEND
# ========================================

APP_NAME=A2A Guard Backend
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Frontend
FRONTEND_ORIGIN=http://localhost:3000

# ========================================
# AGENT 2 — INDIA / SOUTH INDIA
# ========================================

AGENT2_NAME=agent-2-india
AGENT2_REGION=south-india
AGENT2_MODEL=gpt-4o
AGENT2_OPENAI_API_KEY=your_agent2_openai_api_key_here

# Agent 2 Azure Overrides (Optional - fallback to shared Azure settings below)
# AGENT2_AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AGENT2_AZURE_API_KEY=your_agent2_azure_api_key_here
# AGENT2_AZURE_DEPLOYMENT=gpt-4o
# AGENT2_AZURE_API_VERSION=2024-08-01-preview

# ========================================
# AGENT 1 — EUROPE / NORTH EUROPE
# ========================================

AGENT1_NAME=agent-1-europe
AGENT1_REGION=north-europe
AGENT1_MODEL=gpt-5.4mini
AGENT1_OPENAI_API_KEY=your_agent1_openai_api_key_here

# Agent 1 Azure Overrides (Optional - fallback to shared Azure settings below)
# AGENT1_AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AGENT1_AZURE_API_KEY=your_agent1_azure_api_key_here
# AGENT1_AZURE_DEPLOYMENT=gpt-4o
# AGENT1_AZURE_API_VERSION=2024-08-01-preview

# ========================================
# AZURE OPENAI / AZURE API (SHARED)
# ========================================
# Set these if using Azure OpenAI instead of public OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ========================================
# SYNTHETIC DATA
# ========================================

SYNTHETIC_DATA_PATH=app/data/synthetic_customers.json

# ========================================
# TEST CONFIGURATION
# ========================================

TEST_DATA_MINIMIZATION_VIOLATION=false
ENABLE_SYNTHETIC_DATA_ONLY=true

# ========================================
# LOGGING
# ========================================

LOG_LEVEL=INFO
